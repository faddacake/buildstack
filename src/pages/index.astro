---
import Base from '../layouts/Base.astro'; import {useCases,tools,toolBy,comparisons,NEWS,UPDATED} from '../data.js'; import {faqLd,notForSale} from '../seo.js';
const list={'@context':'https://schema.org','@type':'ItemList',name:'BuildJury: AI build tool verdicts by use case',itemListElement:useCases.map((u,i)=>({'@type':'ListItem',position:i+1,name:u.title,url:new URL(`/use-cases/${u.slug}/`,Astro.site).href}))};
const org={'@context':'https://schema.org','@type':'WebSite',name:'BuildJury',url:Astro.site.href,description:'Independent, never-for-sale rankings of AI coding tools, vibe-coding app builders, agent frameworks and MCP servers by use case.',publisher:{'@type':'Organization',name:'BuildJury',url:Astro.site.href,email:'buildstack@mail.grokbot.com'}};
const faqs=[
 {q:'What is BuildJury?',a:`BuildJury ranks ${tools.length} AI building tools (AI coding agents, vibe-coding app builders, agent frameworks and MCP servers) by use case, with short pros and cons and links to official sites.`},
 {q:'What is the best AI coding tool for an existing codebase?',a:`BuildJury currently ranks ${useCases.find(u=>u.slug==='coding-in-existing-codebase').rank.slice(0,4).map((s,i)=>`#${i+1} ${toolBy[s].name}`).join(', ')}.`},
 {q:'What is the best AI app builder for a SaaS MVP?',a:`BuildJury currently ranks ${useCases.find(u=>u.slug==='saas-mvp').rank.slice(0,3).map((s,i)=>`#${i+1} ${toolBy[s].name}`).join(', ')}.`},
 {q:'How often is BuildJury updated?',a:`Rankings are reviewed weekly. Last update: ${UPDATED}.`},
 notForSale];
---
<Base title="BuildJury: best AI coding tools, app builders & MCP servers by use case (2026)" description={`Independent, never-for-sale rankings of ${tools.length} AI coding agents, vibe-coding app builders, agent frameworks and MCP servers, by what you want to build. Updated ${UPDATED}.`} jsonld={[org,list,faqLd(faqs)]} faqs={faqs}>
<h1>Independent verdicts on AI build tools, by use case</h1>
<p>Pick what you're building. We rank vibe-coding tools, AI app builders, agent frameworks and MCP servers with short, honest pros and cons. Rankings are never for sale. Updated {UPDATED}.</p>
<h2 id="use-cases">Use cases</h2><div class="grid">
{useCases.map(u=><a class="card" href={`/use-cases/${u.slug}/`}><strong>{u.short}</strong><p class="muted">{u.intro}</p><p class="muted">#1: {toolBy[u.rank[0]].name}</p></a>)}
</div>
<h2>Head-to-head comparisons</h2><ul>{comparisons.map(c=><li><a href={`/compare/${c.slug}/`}>{c.title}</a></li>)}</ul>
<h2>What's new</h2><ul>{NEWS.slice(0,5).map(n=><li><span class="muted">{n.date}</span> <a href={`/tools/${n.tool}/`}>{toolBy[n.tool].name}</a>: {n.text}</li>)}</ul>
<p><a href="/news/">All updates →</a></p>
<p>{tools.length} tools tracked. <a href="/tools/">See all tools →</a></p>
</Base>
