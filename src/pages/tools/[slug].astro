---
import Base from '../../layouts/Base.astro'; import Watch from '../../components/Watch.astro'; import Record from '../../components/Record.astro';
import {tools,toolBy,casesFor,compareFor} from '../../data.js'; import {lc,record,EDITOR,EDITOR_BIO,UPDATED,NEWSLETTER,AS_OF} from '../../lib.js'; import {breadcrumb,faqLd,toolFaqs,softwareLd} from '../../seo.js';
export function getStaticPaths(){return tools.map(t=>({params:{slug:t.slug},props:{t}}))}
const {t}=Astro.props; const cs=casesFor(t.slug); const cmp=compareFor(t.slug); const news=record.filter(n=>n.tool===t.slug);
const alts=[...new Set(cs.flatMap(u=>u.rank))].filter(s=>s!==t.slug).slice(0,6).map(s=>toolBy[s]);
const crumbs=[['Home','/'],['Tools','/tools/'],[t.name,`/tools/${t.slug}/`]];
const faqs=toolFaqs(t);
const sw={...softwareLd(t,Astro.site),dateModified:news[0]?.date||UPDATED,review:{'@type':'Review',author:{'@type':'Organization',name:'BuildJury',url:Astro.site.href},datePublished:UPDATED,reviewBody:`${t.desc} In favor: ${t.pros.join('; ')}. Objections: ${t.cons.join('; ')}.`,publisher:{'@type':'Organization',name:'BuildJury'}}};
const ranks=cs.map(u=>({u,r:u.rank.indexOf(t.slug)+1}));
---
<Base title={`${t.name} review (2026): pros, cons, pricing & alternatives | BuildJury`} description={`${t.desc} Pros, cons, pricing and the best alternatives.`.slice(0,300)} jsonld={[sw,breadcrumb(Astro.site,crumbs),faqLd(faqs)]} crumbs={crumbs} faqs={faqs} reviewed ogTitle={t.name}>
<p class="mono small muted">{t.cat.toUpperCase()}</p>
<h1>{t.name}</h1>
<p><strong>{ranks.length?`${AS_OF}, BuildJury ranks ${t.name} ${ranks.map(x=>`#${x.r} for ${lc(x.u.short)}`).join(', ')}.`:`${AS_OF}, BuildJury tracks ${t.name} but does not rank it in a ruling.`}</strong> {t.desc}</p>
<p><a class="btn btn-p" href={t.url} rel="noopener" target="_blank">Official site →</a> <Watch slug={t.slug} label={t.name}/></p>
{ranks.length>0 && <Fragment><h2>Where it ranks</h2><div class="chips">{ranks.map(x=><a class="chip mono" href={`/use-cases/${x.u.slug}/`}>{x.u.short} #{x.r}</a>)}</div></Fragment>}
<h2>Pricing</h2><p class="price">{t.price}</p><p class="small muted">BuildJury only states prices confirmed on the official pricing page.</p>
<div class="cols"><div class="favor" aria-label="Pros"><h2>In favor</h2><ul>{t.pros.map(p=><li>{p}</li>)}</ul></div><div class="object" aria-label="Cons"><h2>Objections</h2><ul>{t.cons.map(p=><li>{p}</li>)}</ul></div></div>
{news.length>0 && <Fragment><h2>Recent changes</h2><Record items={news} tabs={false} showTool={false}/></Fragment>}
<aside class="card" style="margin:24px 0"><h2 style="margin-top:0;font-size:22px">Get alerted when {t.name} changes</h2><p>The Friday Verdict flags ranking, pricing and security changes to the tools you use.</p><a class="btn btn-p" href="#friday-verdict">Subscribe free</a> <a class="small" href={`${NEWSLETTER}/subscribe?utm_source=buildjury&utm_medium=tool&utm_campaign=${t.slug}`} rel="noopener">or on beehiiv →</a></aside>
{cmp.length>0 && <Fragment><h2>Compare</h2><ul>{cmp.map(c=><li><a href={`/compare/${c.slug}/`}>{c.title}</a></li>)}</ul></Fragment>}
{alts.length>0 && <Fragment><h2>Alternatives to {t.name}</h2><ul>{alts.map(a=><li><a href={`/tools/${a.slug}/`}>{a.name}</a> <span class="muted">({a.cat})</span></li>)}</ul></Fragment>}
<p class="byline">Reviewed by <a href="/about/">{EDITOR}</a>: {EDITOR_BIO}</p>
</Base>
