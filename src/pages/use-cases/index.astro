---
import Base from '../../layouts/Base.astro'; import {useCases,toolBy,UPDATED} from '../../data.js'; import {breadcrumb} from '../../seo.js';
const crumbs=[['Home','/'],['Rulings','/use-cases/']];
const list={'@context':'https://schema.org','@type':'ItemList',name:'AI build tool rankings by use case',itemListElement:useCases.map((u,i)=>({'@type':'ListItem',position:i+1,name:u.title,url:new URL(`/use-cases/${u.slug}/`,Astro.site).href}))};
---
<Base title="AI tool rankings by use case (2026) | BuildJury" description={`${useCases.length} independent rankings: best AI tools for landing pages, SaaS MVPs, mobile apps, internal tools, AI agents, terminal coding agents, MCP servers and more.`} jsonld={[list,breadcrumb(Astro.site,crumbs)]} crumbs={crumbs}>
<p class="mono small muted">RULINGS</p><h1>AI tool rankings by use case</h1><p>{useCases.length} rulings, each a ranked verdict for one job. Updated <time datetime={UPDATED}>{UPDATED}</time>.</p><div class="grid">
{useCases.map(u=><div class="card"><h2 style="margin-top:0;font-size:22px"><a href={`/use-cases/${u.slug}/`}>{u.title}</a></h2><p class="small">{u.intro}</p><ol class="small mono">{u.rank.map(s=><li>{toolBy[s].name}</li>)}</ol></div>)}</div>
</Base>
