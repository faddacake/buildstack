---
import Base from '../../layouts/Base.astro'; import {comparisons,toolBy,casesFor,newsFor,UPDATED} from '../../data.js'; import {breadcrumb,faqLd,compareFaqs,softwareLd} from '../../seo.js';
export function getStaticPaths(){return comparisons.map(c=>({params:{slug:c.slug},props:{c}}))}
const {c}=Astro.props; const A=toolBy[c.a], B=toolBy[c.b];
const crumbs=[['Home','/'],['Compare','/compare/'],[c.title,`/compare/${c.slug}/`]];
const faqs=compareFaqs(c);
const shared=casesFor(c.a).filter(u=>u.rank.includes(c.b));
const article={'@context':'https://schema.org','@type':'Article',headline:`${c.title} (2026)`,description:c.verdict,dateModified:UPDATED,author:{'@type':'Organization',name:'BuildJury'},publisher:{'@type':'Organization',name:'BuildJury'},about:[softwareLd(A,Astro.site),softwareLd(B,Astro.site)]};
const rows=[['Category',A.cat,B.cat],['Pricing',A.price,B.price],['Pros',A.pros.join('; '),B.pros.join('; ')],['Cons',A.cons.join('; '),B.cons.join('; ')]];
---
<Base title={`${c.title} (2026): which should you use? | BuildJury`} description={c.verdict.slice(0,155)} jsonld={[article,breadcrumb(Astro.site,crumbs),faqLd(faqs)]} crumbs={crumbs} faqs={faqs}>
<h1>{c.title}</h1><p class="muted">Independent verdict · Updated {UPDATED}</p>
<p><strong>Verdict:</strong> {c.verdict}</p>
<table><thead><tr><th></th><th><a href={`/tools/${A.slug}/`}>{A.name}</a></th><th><a href={`/tools/${B.slug}/`}>{B.name}</a></th></tr></thead>
<tbody>{rows.map(r=><tr><th>{r[0]}</th><td>{r[1]}</td><td>{r[2]}</td></tr>)}</tbody></table>
<h2>Choose {A.name} if…</h2><ul>{c.chooseA.map(x=><li>{x}</li>)}</ul>
<h2>Choose {B.name} if…</h2><ul>{c.chooseB.map(x=><li>{x}</li>)}</ul>
{shared.length>0 && <Fragment><h2>Where they rank</h2><ul>{shared.map(u=><li><a href={`/use-cases/${u.slug}/`}>{u.title}</a>: {A.name} #{u.rank.indexOf(c.a)+1}, {B.name} #{u.rank.indexOf(c.b)+1}</li>)}</ul></Fragment>}
{[...newsFor(c.a),...newsFor(c.b)].length>0 && <Fragment><h2>Recent changes</h2><ul>{[...newsFor(c.a),...newsFor(c.b)].map(n=><li><span class="muted">{n.date}</span> {toolBy[n.tool].name}: {n.text} <a href={n.src} rel="noopener" target="_blank">Source</a></li>)}</ul></Fragment>}
<p>Official sites: <a href={A.url} rel="noopener" target="_blank">{A.name}</a> · <a href={B.url} rel="noopener" target="_blank">{B.name}</a></p>
<p><a href="/compare/">More comparisons →</a></p>
</Base>
